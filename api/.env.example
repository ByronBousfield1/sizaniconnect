# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://sizani:sizani@localhost:5432/sizani_dev
DATABASE_SSL=false
# Long random strings in production (32+ characters). Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
ID_HASH_PEPPER=dev-only-id-pepper-change-me-0123456789
APP_BASE_URL=http://localhost:5173
# Optional. Without it, emails are written to the log instead of sent.
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=SizaniConnect <no-reply@sizani.test>
# Seeds demo sites, users, households, stock and events when the database is empty.
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=Sizani-Demo-2026
